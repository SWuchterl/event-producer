Universe   = vanilla
Executable = run_dnntuples.sh

PROCABBR = infer_znunu2j_150to250
PROCNAME = Z2JetsToNuNu_M-50_LHEFilterPtZ-150To250


CMSRUNARGS = 'isTrainSample=0'
# send to CERN T2 /eos/cms/store/group/cmst3/group/deepjet/ScoutingAK15/OfflineTrees_v2/
EOSPATH = root://eoscms.cern.ch//store/group/cmst3/group/deepjet/ScoutingAK15/OfflineTrees_v2/dnntuples/v10_ul_train/inferv2/$(PROCNAME)/dnnTuples_$(Cluster)-$(Process).root

# on lxplus condor: can use local CMSSW dir
WORKAREA = local

# cannot remove " because $(CMSRUNARGS) has white spaces in it
Arguments = "$(WORKAREA) $(Infiles) $(CMSRUNARGS) $(EOSPATH)"

# on lxplus condor: request el7 machine
MY.WantOS = "el7"
request_cpus = 1
request_memory = 1024
use_x509userproxy = true
+AccountingGroup = "group_u_CMST3.all"

+JobFlavour = "tomorrow"

Log        = log/job.log_$(Cluster)
Output     = log/job.out_$(Cluster)-$(Process)
Error      = log/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = dummy.cc


Queue Infiles from ../cmsconnect_dnntuplev10_scoutingak15/samples/fabio/mc_2017_$(PROCABBR).txt