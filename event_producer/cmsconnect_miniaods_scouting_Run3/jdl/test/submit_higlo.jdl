Universe   = vanilla
Executable = run_and_transfer.sh

# custom args
NEVENT = 500
NEVENTLUMIBLOCK = 500
NTHREAD = 1
PROCNAME = BulkGravitonToHHTo4QGluLTau_MH-125_LowPt
# send to CERN T2 /eos/cms/store/group/cmst3/group/deepjet/ScoutingAK15/OfflineTrees/
EOSPATH = root://eoscms.cern.ch//store/group/cmst3/group/deepjet/ScoutingAK15/2024MiniAOD_v2_test/$(PROCNAME)/MiniAODv6/miniv6_$(Cluster)-$(Process).root

# note: use different seeds in different H->2prong and H->WW/ZZ routines to avoid overlap in LHE events
BEGINSEED = 21013

Arguments = $(JOBNUM) $(NEVENT) $(NEVENTLUMIBLOCK) $(NTHREAD) $(PROCNAME) $(BEGINSEED) $(EOSPATH) $(LHEPRODSCRIPT)

#MY.WantOS = "el8"
MY.SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"
request_cpus = 1
request_memory = 2000
use_x509userproxy = true
+AccountingGroup = "group_u_CMST3.all"

+JobFlavour = "tomorrow"

Log        = log/job.log_$(Cluster)
Output     = log/job.out_$(Cluster)-$(Process)
Error      = log/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = dummy.cc

Queue JOBNUM from seq 1 500 |
