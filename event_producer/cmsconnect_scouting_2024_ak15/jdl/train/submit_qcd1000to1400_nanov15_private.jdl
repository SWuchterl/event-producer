Universe   = vanilla
Executable = run_dnntuples.sh


PROCABBR = qcd1000to1400
PROCNAME = QCD_PT-1000to1400_TuneCP5_13p6TeV_pythia8

CMSRUNARGS = 'isTrainSample=1 addLowLevel=1'
# send to CERN T2 /eos/cms/store/group/cmst3/group/deepjet/ScoutingAK15/ScoutingTrees_v2/
EOSPATH = root://eoscms.cern.ch//store/group/cmst3/group/deepjet/ScoutingAK15/ScoutingTrees_v2/dnntuples/v10_ul_train/$(PROCNAME)/dnnTuples_$(Cluster)-$(Process).root

# on lxplus condor: can use local CMSSW dir
WORKAREA = local

# cannot remove " because $(CMSRUNARGS) has white spaces in it
Arguments = "$(WORKAREA) $(Infiles) $(CMSRUNARGS) $(EOSPATH)"

# on lxplus condor: request el7 machine
MY.WantOS = "el9"
request_cpus = 1
request_memory = 1024
use_x509userproxy = true
+AccountingGroup = "group_u_CMST3.all"

+JobFlavour = "tomorrow"

Log        = log/log/job.log_$(Cluster)
Output     = log/out/job.out_$(Cluster)-$(Process)
Error      = log/err/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files = run_dnntuples.sh
transfer_output_files   = dummy.cc


Queue Infiles from samples/mc_2024_$(PROCABBR)_private_filelist.txt